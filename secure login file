<?php
declare(strict_types=1);
require __DIR__ . '/session.php';
require __DIR__ . '/db.php';

require_once __DIR__ . '/vendor/autoload.php';

$message = "";

/* =========================
   GENERATE CSRF TOKEN
========================= */
if (!isset($_SESSION['login_token'])) {
    $_SESSION['login_token'] = bin2hex(random_bytes(32));
}

/* =========================
   LOGIN FORM
========================= */
if ($_SERVER['REQUEST_METHOD'] === 'POST') {

    /* CSRF CHECK */
    if (
        !isset($_POST['login_token']) ||
        !hash_equals($_SESSION['login_token'], $_POST['login_token'])
    ) {
        $message = "Invalid session. Refresh page.";
    } else {

        $email = strtolower(trim($_POST['email'] ?? ''));
        $password = $_POST['password'] ?? '';

        if (empty($email) || empty($password)) {

            $message = "Enter email and password.";

        } else {

            /* =========================
               FETCH ADMIN USER
            ========================= */
            $stmt = $pdo->prepare("
                SELECT
                    id,
                    name,
                    email,
                    password,
                    role,
                    twofa_secret,
                    twofa_enabled
                FROM employer
                WHERE email = ?
                AND role = 'admin'
                LIMIT 1
            ");

            $stmt->execute([$email]);
            $user = $stmt->fetch(PDO::FETCH_ASSOC);

            /* =========================
               INVALID LOGIN
            ========================= */
            if (!$user || !password_verify($password, $user['password'])) {

                $message = "Invalid login details.";

            } else {

          session_regenerate_id(true);

$_SESSION['user_id'] = $user['id'];
$_SESSION['role'] = $user['role'];
$_SESSION['username'] = $user['name'];

/* RESET 2FA STATUS FOR NEW LOGIN */
$pdo->prepare("
    UPDATE employer
    SET two_fa_verified = 0
    WHERE id = ?
")->execute([$user['id']]);

/* FIRST TIME USER -> SETUP 2FA */
if (
    empty($user['twofa_secret']) ||
    (int)$user['twofa_enabled'] !== 1
) {
    header("Location: setup_2fa.php");
    exit;
}

/* EXISTING USER -> VERIFY 2FA */
header("Location: verify_2fa.php");
exit;
            }
        }
    }

    /* Generate new token after POST */
    $_SESSION['login_token'] = bin2hex(random_bytes(32));
}
?>

